rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Setiap akun hanya boleh membaca dan mengubah dokumen miliknya sendiri.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
    // Tolak akses ke koleksi/dokumen lain sampai ada aturan khusus.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
